# Shared platform URLs and auth.
PLATFORM_DOMAIN=os7.dev
SITE_DOMAIN=www.os7.dev
CANVAS_DOMAIN=canvas.os7.dev
PLATFORM_BASE_URL=https://os7.dev
PLATFORM_URL=https://os7.dev/
CANVAS_PUBLIC_BASE_URL=https://canvas.os7.dev
CANVAS_RUNTIME_URL=http://canvas
SITE_URL=https://www.os7.dev/
PROJECT_PUBLIC_SCHEME=https
OAUTH_INTERNAL_BASE_URL=http://web
AUTH_SECRET=change-me-production-auth-secret
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Web/worker agent model defaults.
PROJECT_USE_AGENT_MODEL=x-ai/grok-4.3
PROJECT_DEV_AGENT_MODEL=openai/gpt-5
USER_AGENT_MODEL=openai/gpt-5
AGENT_EMBEDDING_MODEL=openai/text-embedding-3-small
AGENT_EMBEDDING_DIMENSIONS=1536
AGENT_IMAGE_EXTRACTION_MODEL=openai/gpt-4o-mini
HUB_TOPIC_ENRICHMENT_MODEL=openai/gpt-4o-mini
RESEND_API_KEY=re-change-me
EMAIL_FROM=login@os7.dev

# Worker deployment queue and readiness checks.
DEPLOY_WORKER_CONCURRENCY=2
APP_READY_BASE_URL=http://traefik
DEPLOY_APP_READY_TIMEOUT_MS=900000

# Browser automation service used for URL screenshots and future page capture jobs.
BROWSERLESS_URL=http://browserless:3000
BROWSERLESS_TOKEN=change-me-browserless-token
BROWSERLESS_TIMEOUT_MS=60000
BROWSERLESS_CONCURRENT=2
HUB_ARTIFACT_SCREENSHOT_WORKER_CONCURRENCY=2
HUB_URL_SCREENSHOT_FULL_PAGE=false
HUB_URL_SCREENSHOT_TIMEOUT_MS=60000
HUB_URL_SCREENSHOT_WAIT_MS=1000
HUB_PDF_THUMBNAIL_TIMEOUT_MS=60000
HUB_PDF_THUMBNAIL_WAIT_MS=1000
HUB_PDF_THUMBNAIL_VIEWPORT_WIDTH=900
HUB_PDF_THUMBNAIL_VIEWPORT_HEIGHT=1200

# S3-compatible object storage exposed by SeaweedFS.
STORAGE_S3_ENDPOINT=http://seaweedfs:8333
STORAGE_S3_INTERNAL_ENDPOINT=http://seaweedfs:8333
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET_PREFIX=os7
STORAGE_S3_BUCKET=os7-web
STORAGE_S3_ACCESS_KEY_ID=change-me-web-storage-access-key
STORAGE_S3_SECRET_ACCESS_KEY=change-me-web-storage-secret-key
STORAGE_S3_FORCE_PATH_STYLE=true

# Canvas runtime storage. Provision with: make bootstrap-storage
CANVAS_S3_BUCKET=os7-canvas
CANVAS_S3_ACCESS_KEY_ID=change-me-canvas-storage-access-key
CANVAS_S3_SECRET_ACCESS_KEY=change-me-canvas-storage-secret-key
CANVAS_INTERNAL_TOKEN=change-me-canvas-internal-token
CANVAS_SCRIPT_SRC="'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://cdn.tailwindcss.com"
CANVAS_STYLE_SRC="'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com"
CANVAS_CONNECT_SRC="'none'"

# Mastra agent runtime.
OPENROUTER_API_KEY=sk-or-v1-change-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MASTRA_DATABASE_SCHEMA=mastra

# Deployed project defaults.
PROJECT_MEMORY_RESERVATION_MB=128
PROJECT_MEMORY_LIMIT_MB=768
PROJECT_CPU_RESERVATION=0.05
PROJECT_CPU_LIMIT=1

# Platform service resource limits.
WEB_REPLICAS=2
SITE_REPLICAS=2
CANVAS_REPLICAS=1
TRAEFIK_CPUS=0.50
TRAEFIK_MEMORY_LIMIT=512m
MANAGER_CPUS=0.50
MANAGER_MEMORY_LIMIT=512m
WEB_CPUS=1.00
WEB_MEMORY_LIMIT=1024m
SITE_CPUS=0.50
SITE_MEMORY_LIMIT=512m
WORKER_CPUS=1.00
WORKER_MEMORY_LIMIT=1024m
AGENT_CPUS=1.00
AGENT_MEMORY_LIMIT=1024m
CANVAS_CPUS=0.50
CANVAS_MEMORY_LIMIT=512m
BROWSERLESS_CPUS=1.00
BROWSERLESS_MEMORY_LIMIT=1536m
