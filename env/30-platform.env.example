# Shared platform URLs and auth.
PLATFORM_DOMAIN=os7.dev
SITE_DOMAIN=www.os7.dev
PLATFORM_BASE_URL=https://os7.dev
PLATFORM_URL=https://os7.dev/
SITE_URL=https://www.os7.dev/
PROJECT_PUBLIC_SCHEME=https
OAUTH_INTERNAL_BASE_URL=http://web
AUTH_SECRET=change-me-production-auth-secret

# Web/worker agent model defaults.
PROJECT_USE_AGENT_MODEL=x-ai/grok-4.3
PROJECT_DEV_AGENT_MODEL=openai/gpt-5
USER_AGENT_MODEL=openai/gpt-5
RESEND_API_KEY=re-change-me
EMAIL_FROM=onboarding@resend.dev

# Worker deployment queue and readiness checks.
DEPLOY_WORKER_CONCURRENCY=2
APP_READY_BASE_URL=http://traefik
DEPLOY_APP_READY_TIMEOUT_MS=900000

# Mastra agent runtime.
OPENROUTER_API_KEY=sk-or-v1-change-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MASTRA_DATABASE_SCHEMA=mastra

# Deployed project defaults.
PROJECT_MEMORY_RESERVATION_MB=128
PROJECT_MEMORY_LIMIT_MB=768
PROJECT_CPU_RESERVATION=0.05
PROJECT_CPU_LIMIT=1

# Platform service resource limits.
TRAEFIK_CPUS=0.50
TRAEFIK_MEMORY_LIMIT=512m
MANAGER_CPUS=0.50
MANAGER_MEMORY_LIMIT=512m
WEB_CPUS=1.00
WEB_MEMORY_LIMIT=1024m
SITE_CPUS=0.50
SITE_MEMORY_LIMIT=512m
WORKER_CPUS=1.00
WORKER_MEMORY_LIMIT=1024m
AGENT_CPUS=1.00
AGENT_MEMORY_LIMIT=1024m
