ROOT_DOMAIN=llmagents.com
APP_ROOT_DOMAIN=llmagents.com
WEB_DOMAIN=app.llmagents.com

MANAGER_IMAGE=ghcr.io/llm-to-apps/manager
MANAGER_IMAGE_TAG=latest
WEB_IMAGE=ghcr.io/llm-to-apps/web
WEB_IMAGE_TAG=latest
AGENT_IMAGE=ghcr.io/llm-to-apps/agent
AGENT_IMAGE_TAG=latest
USER_INSTANCE_IMAGE=llagents/user-instance:latest
TRAEFIK_IMAGE=traefik:v3.7
MYSQL_IMAGE=mysql:8.4
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine

DB_NETWORK_ID=llagents_db
INGRESS_NETWORK_ID=llagents_ingress
INTERNAL_NETWORK_ID=llagents_internal

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_ROOT_USER=root
MYSQL_HOST=mysql
POSTGRES_USER=llagents
POSTGRES_PASSWORD=change-me-platform-password
POSTGRES_DATABASE=llagents_platform
MASTRA_DATABASE_SCHEMA=mastra
AUTH_SECRET=change-me-production-auth-secret
DEPLOY_WORKER_CONCURRENCY=2

OPENROUTER_API_KEY=sk-or-v1-change-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=LLM to Apps
AGENT_MODEL=openai/gpt-5-mini
