WEB_IMAGE=ghcr.io/llm-to-apps/web
WEB_IMAGE_TAG=latest
AGENT_IMAGE=ghcr.io/llm-to-apps/agent
AGENT_IMAGE_TAG=latest
USER_INSTANCE_IMAGE=llagents/user-instance:latest
TRAEFIK_IMAGE=traefik:v3.7
MYSQL_IMAGE=mysql:8.4
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:15

DB_NETWORK_ID=llagents_db
INGRESS_NETWORK_ID=llagents_ingress
INTERNAL_NETWORK_ID=llagents_internal

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_ROOT_USER=root
MYSQL_HOST=mysql
POSTGRES_USER=llagents
POSTGRES_PASSWORD=change-me-platform-password
POSTGRES_DATABASE=llagents_platform
MASTRA_DATABASE_SCHEMA=mastra
AUTH_SECRET=change-me-production-auth-secret
DEPLOY_WORKER_CONCURRENCY=2
APP_READY_BASE_URL=http://traefik
DEPLOY_APP_READY_TIMEOUT_MS=900000
AGENT_MEMORY_DEBUG=false

FORGEJO_URL=http://forgejo:3000
FORGEJO_GIT_URL=http://forgejo:3000
FORGEJO_ROOT_URL=https://git.llmagents.com/
FORGEJO_SSH_DOMAIN=git.llmagents.com
FORGEJO_SSH_PORT=2222
FORGEJO_POSTGRES_DATABASE=forgejo
FORGEJO_POSTGRES_USER=forgejo
FORGEJO_POSTGRES_PASSWORD=change-me-forgejo-postgres-password
FORGEJO_SECRET_KEY=change-me-forgejo-secret-key
FORGEJO_INTERNAL_TOKEN=change-me-forgejo-internal-token
FORGEJO_DISABLE_REGISTRATION=false
FORGEJO_ADMIN_USER=root
FORGEJO_ADMIN_PASSWORD=change-me-forgejo-admin-password
FORGEJO_ADMIN_EMAIL=root@llmagents.com

PROJECT_MEMORY_RESERVATION_MB=128
PROJECT_MEMORY_LIMIT_MB=768
PROJECT_CPU_RESERVATION=0.05
PROJECT_CPU_LIMIT=1

TRAEFIK_CPUS=0.50
TRAEFIK_MEMORY_LIMIT=512m
MANAGER_CPUS=0.50
MANAGER_MEMORY_LIMIT=512m
WEB_CPUS=1.00
WEB_MEMORY_LIMIT=1024m
WORKER_CPUS=1.00
WORKER_MEMORY_LIMIT=1024m
AGENT_CPUS=1.00
AGENT_MEMORY_LIMIT=1024m
FORGEJO_CPUS=1.00
FORGEJO_MEMORY_LIMIT=1024m
POSTGRES_CPUS=2.00
POSTGRES_MEMORY_LIMIT=2048m
MYSQL_CPUS=2.00
MYSQL_MEMORY_LIMIT=2048m
REDIS_CPUS=0.50
REDIS_MEMORY_LIMIT=512m

OPENROUTER_API_KEY=sk-or-v1-change-me
